# Communication Service configuration
# (Python namespace package; run via `communication.main:app` from
# services/communication/)
# IMPORTANT: never commit a real secret. Replace the placeholder SECRET_KEY with
# a long, random value and keep it identical to the Backend and AI services.
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COMMUNICATION_PORT=8002
