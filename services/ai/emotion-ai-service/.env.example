# Emotion AI Service configuration
# (Loaded by python-dotenv where needed; the FastAPI app reads settings
# from app.core.settings and accepts the shared SECRET_KEY for JWT auth.)
# IMPORTANT: never commit a real secret. Replace the placeholder with a long,
# random value and keep it identical to the Backend and Communication services.
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
AI_SERVICE_PORT=8001
