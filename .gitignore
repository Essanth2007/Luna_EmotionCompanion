# Environments and Secrets
.env
.env.*
.venv/
venv/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.db

# Testing and Linters
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS and IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# TLS certificates — never commit private keys or cert chains
nginx/certs/*.pem
nginx/certs/*.crt
nginx/certs/*.key
nginx/certs/*.p12
nginx/certs/*.pfx
